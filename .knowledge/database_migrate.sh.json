{"is_source_file": true, "format": "bash", "description": "This script automates the process of applying SQL migration files to a PostgreSQL database. It manages migrations by tracking applied versions in a schema_migrations table, executing pending migrations in lex order, and ensuring idempotency and error handling.", "external_files": ["db_connection.txt", "migrations", "schema_migrations", "*.sql"], "external_methods": ["cat", "[ -f ]", "echo", "exit", "basename", "mkdir", "${PSQL_CMD}", "shopt", "for"], "published": [], "classes": [], "methods": [], "calls": ["cat ${CONN_FILE}", "[ ! -f ${CONN_FILE} ]", "echo", "exit 1", "${PSQL_CMD} -v ON_ERROR_STOP=1 -c \"CREATE TABLE IF NOT EXISTS schema_migrations (version TEXT PRIMARY KEY, applied_at TIMESTAMPTZ NOT NULL DEFAULT now());\"", "shopt -s nullglob", "for file in \"${MIGRATION_FILES[@]}\"", "basename \"${file}\"", "${PSQL_CMD} -t -A -c \"SELECT 1 FROM schema_migrations WHERE version='${version}' LIMIT 1;\"", "${PSQL_CMD} -v ON_ERROR_STOP=1 -f \"${file}\"", "${PSQL_CMD} -v ON_ERROR_STOP=1 -c \"INSERT INTO schema_migrations(version) VALUES ('${version}');\""], "search-terms": ["migration runner", "schema_migrations", "migrations directory", "psql command", "sql migration script"], "state": 2, "file_id": 9, "knowledge_revision": 26, "git_revision": "7589f5c433034392c799742c3f81d149ebffbdf4", "hash": "a650b255b758ef5cfd9047aa0c5c5718", "format-version": 4, "code-base-name": "database", "filename": "database/migrate.sh", "revision_history": [{"26": "7589f5c433034392c799742c3f81d149ebffbdf4"}]}